# Dockerfile.prod - Production configuration for nova-engine
# Stage 1: Build native dependencies
FROM node:18-slim AS builder

WORKDIR /usr/src/app

# Install compilation tools needed for node-pty
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm install

COPY . .
RUN npm prune --production

# Stage 2: Minimal Runtime Image
FROM node:18-slim

WORKDIR /usr/src/app

# Install docker CLI (v26.1.3 stable) to enable control of the host docker socket
RUN apt-get update && apt-get install -y curl \
    && curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-26.1.3.tgz | tar -xz -C /tmp \
    && mv /tmp/docker/docker /usr/local/bin/ \
    && rm -rf /tmp/docker \
    && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

# Bring over compiled production node modules and sources
COPY --from=builder /usr/src/app/node_modules ./node_modules
COPY --from=builder /usr/src/app/src ./src

EXPOSE 3000
EXPOSE 9090

# Run as root user to enable docker socket control and workspace mounting
ENV PORT=3000
ENV LOG_FORMAT=json

CMD ["node", "src/server.js"]
