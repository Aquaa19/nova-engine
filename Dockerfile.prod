# Dockerfile.prod - Production configuration for nova-engine
# Stage 1: Build native dependencies
FROM node:18-slim AS builder

WORKDIR /usr/src/app

# Install compilation tools needed for node-pty
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm install

COPY . .

# Stage 2: Minimal Runtime Image
FROM node:18-slim

WORKDIR /usr/src/app

# Install docker CLI to enable control of the host docker socket
RUN apt-get update && apt-get install -y \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm install --only=production

# Bring over compiled node modules and sources
COPY --from=builder /usr/src/app/node_modules ./node_modules
COPY --from=builder /usr/src/app/src ./src

EXPOSE 3000
EXPOSE 9090

# Run as non-root user
USER node

ENV PORT=3000
ENV LOG_FORMAT=json

CMD ["node", "src/server.js"]
